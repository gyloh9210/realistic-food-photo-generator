# Copy to agent-workflow/.env and fill in values.

CURSOR_API_KEY=

# Engineer persona model (defaults to composer-2.5)
# AGENT_WORKFLOW_ENGINEER_MODEL=composer-2.5

# Max parallel engineer runs (defaults to 2)
# AGENT_WORKFLOW_MAX_CONCURRENT=2

# Express API port (Vite proxies /api here)
# AGENT_WORKFLOW_PORT=3001

# Vite dev server port
# VITE_AGENT_WORKFLOW_PORT=5174
